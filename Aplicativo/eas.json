{
    "cli": {
        "version": ">= 7.0.0",
        "appVersionSource": "local"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal"
        },
        "preview": {
            "android": {
                "buildType": "apk",
                "gradleCommand": ":app:assembleRelease"
            },
            "env": {
                "EXPO_NO_CAPABILITY_SYNC": "1",
                "EXPO_PUBLIC_BFF_URL": "https://bff-tau-two.vercel.app"
            },
            "ios": {
                "simulator": true
            }
        },
        "production": {
            "android": {
                "buildType": "app-bundle"
            }
        }
    },
    "submit": {
        "production": {}
    }
}