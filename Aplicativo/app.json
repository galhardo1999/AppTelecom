{
  "expo": {
    "name": "Apollo Telecom",
    "slug": "apollo-telecom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/iconeaplicativo.png",
    "scheme": "apollo-telecom",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "jsEngine": "hermes",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.galhardyn.apollotelecom",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "O Apollo Telecom usa o FaceID para permitir o acesso rápido e seguro à sua conta."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/iconeaplicativo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.galhardyn.apollotelecom"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/iconeaplicativo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cc9deea2-e7df-4565-889e-b36b2596f695"
      }
    }
  }
}